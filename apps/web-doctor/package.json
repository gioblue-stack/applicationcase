{
  "name": "web-doctor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "api:types": "cd ../../backend && ../.venv/bin/python -c \"import json; from app.main import app; json.dump(app.openapi(), open('../apps/web-doctor/src/lib/openapi.json','w'), ensure_ascii=False, indent=1)\" && cd ../apps/web-doctor && openapi-typescript src/lib/openapi.json -o src/lib/api-schema.ts"
  },
  "dependencies": {
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
